    <string name="battery_dialog_tip_xiaomi">Xiaomi: También activa "Inicio automático" en Configuración → Aplicaciones → Administrar aplicaciones → Sound\'ST Boost</string>
    <string name="battery_dialog_tip_samsung">Samsung: Elimina de "Aplicaciones inactivas" en Configuración → Batería → Límites de uso en segundo plano</string>
    <string name="battery_dialog_tip_oneplus">OnePlus: Activa "Permitir actividad en segundo plano" en Información de la aplicación → Batería</string>
    <string name="battery_dialog_tip_huawei">Huawei: Activa "Inicio manual" en Administrador de teléfono → Inicio de aplicaciones</string>
    
