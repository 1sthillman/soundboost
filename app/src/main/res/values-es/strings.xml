    <string name="audio_permission_title">Los Temas Visuales Necesitan Permiso</string>
    <string name="audio_permission_description">Nuestros temas visuales se sincronizan con la música que suena en segundo plano (Spotify, YouTube, etc.). Para que los temas se muevan al ritmo, necesitamos permiso de análisis de audio.</string>
    <string name="audio_permission_why_title">Por Qué Lo Necesitamos</string>
    <string name="audio_permission_why_desc">Los temas responden a la música de aplicaciones externas (Spotify, YouTube). Android requiere permiso de audio para análisis de frecuencia.</string>
    <string name="audio_permission_privacy_title">Tu Privacidad</string>
    <string name="audio_permission_privacy_desc">Los datos de audio se analizan en tiempo real SOLO para animación de temas. NO grabamos, almacenamos ni compartimos datos de audio.</string>
    <string name="audio_permission_technical_title">Detalles Técnicos</string>
    <string name="audio_permission_technical_desc">Usamos la API oficial Visualizer de Android. El audio se procesa localmente en tu dispositivo y se descarta inmediatamente.</string>
