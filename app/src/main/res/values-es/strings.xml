    <!-- Diálogo de Optimización de Batería -->
    <string name="battery_dialog_title">⚡ Configurar Optimización de Batería</string>
    <string name="battery_dialog_subtitle">Mantener Sound Boost funcionando en segundo plano</string>
    <string name="battery_dialog_desc">Algunos dispositivos (Xiaomi, Samsung, OnePlus, Huawei) cierran agresivamente aplicaciones en segundo plano para ahorrar batería. Para mantener el refuerzo de audio activo cuando tu pantalla está apagada, necesitas desactivar la optimización de batería.</string>
    <string name="battery_dialog_step1_title">Paso 1: Abrir Configuración</string>
    <string name="battery_dialog_step1_desc">Toca el botón debajo para abrir la configuración de optimización de batería</string>
    <string name="battery_dialog_step2_title">Paso 2: Buscar Sound\'ST Boost</string>
    <string name="battery_dialog_step2_desc">Desplázate por la lista de aplicaciones y encuentra "Sound\'ST Boost" o búscala</string>
    <string name="battery_dialog_step3_title">Paso 3: Desactivar Optimización</string>
    <string name="battery_dialog_step3_desc">Toca la aplicación y selecciona "No optimizar" o "Permitir"</string>
