    <!-- Batterieoptimierungs-Dialog -->
    <string name="battery_dialog_title">⚡ Batterieoptimierung einrichten</string>
    <string name="battery_dialog_subtitle">Sound Boost im Hintergrund aktiv halten</string>
    <string name="battery_dialog_desc">Einige Geräte (Xiaomi, Samsung, OnePlus, Huawei) beenden aggressive Hintergrund-Apps, um Batterie zu sparen. Um den Audio-Boost aktiv zu halten, wenn Ihr Bildschirm ausgeschaltet ist, müssen Sie die Batterieoptimierung deaktivieren.</string>
    <string name="battery_dialog_step1_title">Schritt 1: Einstellungen öffnen</string>
    <string name="battery_dialog_step1_desc">Tippen Sie auf die Schaltfläche unten, um die Batterieoptimierungseinstellungen zu öffnen</string>
    <string name="battery_dialog_step2_title">Schritt 2: Sound\'ST Boost finden</string>
    <string name="battery_dialog_step2_desc">Scrollen Sie durch die App-Liste und finden Sie "Sound\'ST Boost" oder suchen Sie danach</string>
    <string name="battery_dialog_step3_title">Schritt 3: Optimierung deaktivieren</string>
    <string name="battery_dialog_step3_desc">Tippen Sie auf die App und wählen Sie "Nicht optimieren" oder "Zulassen"</string>
    <string name="battery_dialog_open_settings">Einstellungen öffnen</string>
    <string name="battery_dialog_cancel">Vielleicht später</string>
    <string name="battery_dialog_device_specific">Gerätespezifische Tipps:</string>
    <string name="battery_dialog_tip_xiaomi">Xiaomi: Aktivieren Sie auch "Autostart" in Einstellungen → Apps → Apps verwalten → Sound\'ST Boost</string>
    <string name="battery_dialog_tip_samsung">Samsung: Entfernen Sie aus "Schlafende Apps" in Einstellungen → Batterie → Hintergrundnutzungslimits</string>
    <string name="battery_dialog_tip_oneplus">OnePlus: Aktivieren Sie "Hintergrundaktivität zulassen" in App-Info → Batterie</string>
    <string name="battery_dialog_tip_huawei">Huawei: Aktivieren Sie "Manueller Start" in Telefon-Manager → App-Start</string>
    
