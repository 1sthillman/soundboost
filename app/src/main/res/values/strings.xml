    <string name="battery_optimization_desc">Recommended for Xiaomi, Samsung, OnePlus devices to prevent background service interruption</string>
    
    <!-- Battery Optimization Dialog -->
    <string name="battery_dialog_title">⚡ Battery Optimization Setup</string>
    <string name="battery_dialog_subtitle">Keep Sound Boost working in the background</string>
    <string name="battery_dialog_desc">Some devices (Xiaomi, Samsung, OnePlus, Huawei) aggressively kill background apps to save battery. To keep the audio boost active when your screen is off, you need to disable battery optimization.</string>
    <string name="battery_dialog_step1_title">Step 1: Open Settings</string>
    <string name="battery_dialog_step1_desc">Tap the button below to open battery optimization settings</string>
    <string name="battery_dialog_step2_title">Step 2: Find Sound\'ST Boost</string>
    <string name="battery_dialog_step2_desc">Scroll through the app list and find "Sound\'ST Boost" or search for it</string>
    <string name="battery_dialog_step3_title">Step 3: Disable Optimization</string>
    <string name="battery_dialog_step3_desc">Tap the app and select "Don\'t optimize" or "Allow"</string>
    <string name="battery_dialog_open_settings">Open Settings</string>
    <string name="battery_dialog_cancel">Maybe Later</string>
    <string name="battery_dialog_device_specific">Device-specific tips:</string>
    <string name="battery_dialog_tip_xiaomi">Xiaomi: Also enable "Autostart" in Settings → Apps → Manage apps → Sound\'ST Boost</string>
    <string name="battery_dialog_tip_samsung">Samsung: Remove from "Sleeping apps" in Settings → Battery → Background usage limits</string>
    <string name="battery_dialog_tip_oneplus">OnePlus: Enable "Allow background activity" in App info → Battery</string>
    <string name="battery_dialog_tip_huawei">Huawei: Enable "Manual launch" in Phone Manager → App launch</string>
    
