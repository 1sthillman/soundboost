    <!-- Help & FAQ -->
    <string name="help_and_faq">도움말 및 FAQ</string>
    <string name="faq_how_to_use">앱을 어떻게 사용하나요?</string>
    <string name="faq_how_to_use_answer">중앙 다이얼을 두 번 탭하여 볼륨 부스터를 켭니다. 볼륨 레벨을 조정하려면 위아래로 드래그하거나 원을 그리며 움직입니다. 저음 부스트 및 3D 효과에는 슬라이더를 사용하세요.</string>
    <string name="faq_not_working">부스트가 작동하지 않는 이유는 무엇인가요?</string>
    <string name="faq_not_working_answer">오디오 효과 지원은 기기마다 다릅니다. 일부 제조업체는 오디오 효과 기능을 제한합니다. 다양한 부스트 레벨을 시도하고 기기 볼륨이 0이 아닌지 확인하세요.</string>
    <string name="faq_background_work">백그라운드에서 작동하나요?</string>
    <string name="faq_background_work_answer">네! 활성화되면 다른 앱으로 전환하거나 화면을 잠그더라도 부스트가 계속 작동합니다. 활성 상태인 동안 알림이 표시됩니다.</string>
    <string name="faq_battery">배터리를 소모하나요?</string>
    <string name="faq_battery_answer">앱은 최소한의 배터리 전력을 사용합니다. 효율적인 포그라운드 서비스로 실행되며 부스트가 활성화된 경우에만 오디오를 처리합니다.</string>
    <string name="faq_audio_quality">스피커를 손상시키나요?</string>
    <string name="faq_audio_quality_answer">앱은 안전 제한을 고려하여 설계되었습니다. 그러나 최대 레벨에서 장시간 사용하면 스피커에 부담을 줄 수 있습니다. 장시간 청취에는 적절한 부스트 레벨을 사용하는 것이 좋습니다.</string>
    <string name="faq_device_support">어떤 기기가 지원되나요?</string>
    <string name="faq_device_support_answer">모든 Android 7.0+ 기기가 지원됩니다. 효과 강도는 기기 하드웨어 및 제조업체 오디오 구현에 따라 다를 수 있습니다.</string>
    
