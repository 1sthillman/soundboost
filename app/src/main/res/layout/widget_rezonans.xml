<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Rezonans Widget Layout - Award-winning design -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Background Gradient -->
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Bar: Brand -->
        <LinearLayout
            android:id="@+id/widget_brand_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/widget_brand_re"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="re"
                android:textSize="18sp"
                android:textStyle="italic|bold"
                android:letterSpacing="-0.03"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widget_brand_zo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="zo"
                android:textSize="18sp"
                android:textStyle="italic|bold"
                android:letterSpacing="-0.03"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widget_brand_nans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nans"
                android:textSize="13sp"
                android:layout_marginStart="2dp"
                android:layout_gravity="center_vertical"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Center: Visualizer + Volume Display -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <!-- Visualizer Arc -->
            <ImageView
                android:id="@+id/widget_visualizer"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:contentDescription="Visualizer" />

            <!-- Volume Display (Center of Arc) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/widget_volume_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150%"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Play/Pause Button (Bottom Center) -->
            <FrameLayout
                android:id="@+id/widget_play_container"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/widget_play_bg"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Play background" />

                <ImageView
                    android:id="@+id/widget_play_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="#FF040910"
                    android:contentDescription="Play/Pause" />
            </FrameLayout>
        </FrameLayout>

        <!-- Theme Info + Track Info -->
        <LinearLayout
            android:id="@+id/widget_theme_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/widget_theme_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="6dp"
                android:contentDescription="Theme color" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_theme_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ay Balıkçısı"
                    android:textSize="15sp"
                    android:textStyle="italic|bold"
                    android:letterSpacing="-0.02"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/widget_theme_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Durgun suda sabırla bekleyen"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <!-- Controls: Volume -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/widget_volume_label"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Yükseltme"
                android:textSize="10sp"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_volume_down"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="−"
                android:textSize="20sp"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:fontFamily="sans-serif-light" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:alpha="0.3" />

            <TextView
                android:id="@+id/widget_volume_up"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="+"
                android:textSize="20sp"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:fontFamily="sans-serif-light" />

            <TextView
                android:id="@+id/widget_volume_text"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="150"
                android:textSize="10sp"
                android:gravity="end"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Controls: Sensitivity (Optional - can be hidden if space tight) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_sensitivity_label"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Hassasiyet"
                android:textSize="10sp"
                android:fontFamily="sans-serif" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:alpha="0.3" />

            <TextView
                android:id="@+id/widget_sensitivity_text"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="50"
                android:textSize="10sp"
                android:gravity="end"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
