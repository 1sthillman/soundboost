    <!-- Divulgazione Prominente del Permesso Audio (Google Play Richiesto) -->
    <string name="audio_permission_title">I Temi Visivi Richiedono il Permesso</string>
    <string name="audio_permission_description">I nostri temi visivi si sincronizzano con la musica in riproduzione in background (Spotify, YouTube, ecc.). Per far muovere i temi a ritmo, abbiamo bisogno del permesso di analisi audio.</string>
    <string name="audio_permission_why_title">Perché Ne Abbiamo Bisogno</string>
    <string name="audio_permission_why_desc">I temi rispondono alla musica da app esterne (Spotify, YouTube). Android richiede il permesso audio per l\'analisi delle frequenze.</string>
    <string name="audio_permission_privacy_title">La Tua Privacy</string>
    <string name="audio_permission_privacy_desc">I dati audio vengono analizzati in tempo reale SOLO per l\'animazione dei temi. NON registriamo, memorizziamo o condividiamo alcun dato audio.</string>
    <string name="audio_permission_technical_title">Dettagli Tecnici</string>
    <string name="audio_permission_technical_desc">Utilizziamo l\'API Visualizer ufficiale di Android. L\'audio viene elaborato localmente sul tuo dispositivo e immediatamente scartato.</string>
    <string name="audio_permission_accept">Accetto</string>
    <string name="audio_permission_deny">No Grazie</string>
    <string name="audio_permission_footer">Puoi modificare questo permesso in qualsiasi momento nelle Impostazioni</string>
    
    <!-- Ottimizzazione Batteria (Google Play sicuro) -->
    <string name="battery_optimization">Ottimizzazione Batteria</string>
    <string name="battery_optimization_desc">Consigliato per dispositivi Xiaomi, Samsung, OnePlus per prevenire l\'interruzione del servizio in background</string>
    
    <!-- Finestra Ottimizzazione Batteria -->
    <string name="battery_dialog_title">⚡ Configurazione Ottimizzazione Batteria</string>
    <string name="battery_dialog_subtitle">Mantieni Sound Boost attivo in background</string>
    <string name="battery_dialog_desc">Alcuni dispositivi (Xiaomi, Samsung, OnePlus, Huawei) chiudono aggressivamente le app in background per risparmiare batteria. Per mantenere il potenziamento audio attivo quando lo schermo è spento, è necessario disabilitare l\'ottimizzazione della batteria.</string>
    <string name="battery_dialog_step1_title">Passaggio 1: Apri Impostazioni</string>
    <string name="battery_dialog_step1_desc">Tocca il pulsante qui sotto per aprire le impostazioni di ottimizzazione della batteria</string>
    <string name="battery_dialog_step2_title">Passaggio 2: Trova Sound\'ST Boost</string>
    <string name="battery_dialog_step2_desc">Scorri l\'elenco delle app e trova "Sound\'ST Boost" o cercala</string>
    <string name="battery_dialog_step3_title">Passaggio 3: Disabilita Ottimizzazione</string>
    <string name="battery_dialog_step3_desc">Tocca l\'app e seleziona "Non ottimizzare" o "Consenti"</string>
    <string name="battery_dialog_open_settings">Apri Impostazioni</string>
    <string name="battery_dialog_cancel">Forse Più Tardi</string>
    <string name="battery_dialog_device_specific">Suggerimenti specifici per dispositivo:</string>
    <string name="battery_dialog_tip_xiaomi">Xiaomi: Abilita anche "Avvio automatico" in Impostazioni → App → Gestisci app → Sound\'ST Boost</string>
    <string name="battery_dialog_tip_samsung">Samsung: Rimuovi da "App in sospensione" in Impostazioni → Batteria → Limiti utilizzo in background</string>
    <string name="battery_dialog_tip_oneplus">OnePlus: Abilita "Consenti attività in background" in Informazioni app → Batteria</string>
    <string name="battery_dialog_tip_huawei">Huawei: Abilita "Avvio manuale" in Gestore telefono → Avvio app</string>
    
