    <!-- Aiuto e FAQ -->
    <string name="help_and_faq">Aiuto e FAQ</string>
    <string name="faq_how_to_use">Come si usa?</string>
    <string name="faq_how_to_use_answer">Tocca due volte il controllo centrale per attivare l\'amplificazione, poi trascina per regolare il livello del volume</string>
    <string name="faq_not_working">Non funziona?</string>
    <string name="faq_not_working_answer">Controlla il permesso del microfono e il volume di sistema. Alcuni dispositivi potrebbero avere limitazioni</string>
    <string name="faq_background_work">Funziona in background?</string>
    <string name="faq_background_work_answer">Sì, l\'amplificazione continua a funzionare anche quando l\'app è chiusa</string>
    <string name="faq_battery">Consumo batteria?</string>
    <string name="faq_battery_answer">Consumo minimo della batteria. Gli effetti audio sono accelerati dall\'hardware sulla maggior parte dei dispositivi</string>
    <string name="faq_audio_quality">Qualità audio?</string>
    <string name="faq_audio_quality_answer">Utilizza un\'elaborazione di alta qualità. Evita impostazioni estreme per risultati migliori</string>
    <string name="faq_device_support">Supporto dispositivi?</string>
    <string name="faq_device_support_answer">Funziona su tutti i dispositivi Android. La forza dell\'effetto varia in base all\'hardware</string>
    
