    <!-- Help & FAQ -->
    <string name="help_and_faq">Yardım ve S.S.S.</string>
    <string name="faq_how_to_use">Nasıl kullanılır?</string>
    <string name="faq_how_to_use_answer">Boost\'u etkinleştirmek için ortadaki kontrole çift dokunun, ardından ses seviyesini ayarlamak için sürükleyin</string>
    <string name="faq_not_working">Çalışmıyor mu?</string>
    <string name="faq_not_working_answer">Mikrofon iznini ve sistem ses seviyesini kontrol edin. Bazı cihazlarda sınırlamalar olabilir</string>
    <string name="faq_background_work">Arka planda çalışır mı?</string>
    <string name="faq_background_work_answer">Evet, uygulama kapatıldığında bile boost çalışmaya devam eder</string>
    <string name="faq_battery">Pil kullanımı?</string>
    <string name="faq_battery_answer">Minimal pil kullanımı. Ses efektleri çoğu cihazda donanım hızlandırmalıdır</string>
    <string name="faq_audio_quality">Ses kalitesi?</string>
    <string name="faq_audio_quality_answer">Yüksek kaliteli işleme kullanır. En iyi sonuçlar için aşırı ayarlardan kaçının</string>
    <string name="faq_device_support">Cihaz desteği?</string>
    <string name="faq_device_support_answer">Tüm Android cihazlarda çalışır. Efekt gücü donanıma göre değişir</string>
    
